# Copy this file to .env and fill in the values. .env is never committed.

# Hosted model: Google Gemini, through its OpenAI-compatible endpoint.
# Create the key in Google AI Studio, and set a spend limit / budget alert first.
GEMINI_API_KEY=
# Run `uv run python task4_same_code.py --list-models` to see the model names your key can use.
GEMINI_MODEL=

# Local model (Ollama). No key needed; change the model name if you pulled another one.
LOCAL_MODEL=gemma3:270m
